# Base URL of the FastAPI backend (no trailing slash).
#
# Leave EMPTY to use a relative "/api" path, which the Vite dev server proxies
# to the backend internally (see the `proxy` block in vite.config.ts). This is
# the recommended setup: the browser only ever talks to one origin, so cookies
# are same-site and auth works everywhere, including on mobile browsers that
# block third-party cookies.
#
# Set an absolute URL only if you're serving the backend from somewhere the
# proxy can't reach, in which case also set COOKIE_CROSS_SITE=true on the backend.
VITE_API_BASE_URL=
