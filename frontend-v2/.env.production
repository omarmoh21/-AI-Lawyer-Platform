# Production build (single-origin deployment): the backend serves this built
# frontend, so API calls go to the SAME origin via a relative "/api" path.
#
# Leaving VITE_API_BASE_URL empty makes api.ts produce "/api" (relative), and
# liveTranscribe.ts derive the WebSocket origin from window.location.
#
# Loaded only by `vite build` (production mode) — local `vite dev` ignores this
# file and falls back to http://localhost:8000, so local development is unchanged.
VITE_API_BASE_URL=
